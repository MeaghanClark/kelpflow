// Define work directory
workDir='/data/rufus/pinsky_lab/Mpyr/temp_work/kelpflow_fullrun'

// Default parameters
params {
    input_dir  = null
    outdir = 'results'
    reference_genome = '/home/miclark/MpyrAdapt/data/reference/Mpyr-NLJ1B.v3.hap1.softmasked.fasta'
    raw_report_name = 'raw_reads_qc'
    trimmed_report_name = 'trimmed_reads_qc'
    qualimap_report_name = 'filtered_bams_qc'
    min_cov = '0.5'
    num_genome_segments = '20'
    lr_quantile = 0.98
    depth_cutoff = 2 // median coverage * depth_cutoff = upper bound of depth allowed

    // ngsparalog set up
    singularity_tmpdir = '/hb/scratch/miclark/singularity_tmp'
    tmpdir = '/hb/scratch/miclark/singularity_tmp'

    // angsd
    angsd_snp_pval = '1e-4'

    // LD pruning parameters
    ld_max_kb_dist = 5
    ld_max_bp_dist = 5000
    ld_min_r2 = 0.1
    prune_graph_path = '/home/miclark/software/prune_graph/target/release/prune_graph'
}

// Base resource settings
process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : (task.attempt <= 2 ? 'retry' : 'finish') }
    maxRetries    = 2}

profiles {

    // Run everything on the machine executing `nextflow run`
    standard {
        process.executor = 'local'

        docker.enabled       = true
        singularity.enabled  = false

        // Cap total resources Nextflow is allowed to use
        executor {
            cpus   = 8
            memory = '32.GB'
        }
    }

    // Slurm settings
    slurm {
        process.executor = 'slurm'
        process.queue    = 'lab-mpinsky'   // for running on the pinsky node

        singularity.enabled = true 
        singularity.autoMounts = true
        singularity.cacheDir   = '/hb/scratch/miclark/singularity_cache'

        docker.enabled      = false
        conda.enabled       = true

        executor {
            queueSize = 24
            submitRateLimit = '10/1min'   // throttle how fast Nextflow submits jobs
            exitReadTimeout = '600 minutes'
        }

        // use withLabel or withName to specify module-specific resource usage
        process {
            // cluster options for UCSC elkhorn
            clusterOptions = '--partition=lab-mpinsky --qos=pi-mpinsky --account=pi-mpinsky'

            withLabel: process_low {
                cpus   = 1
                memory = '4.GB'
                time   = '24.h'
            }
            withLabel: process_medium {
                cpus   = 4
                memory = '64.GB'
                time   = '72.h'
            }
            withLabel: process_high {
                cpus   = 16
                memory = '200.GB'
                time   = '168.h'
            }
            withName: ALIGN{
                cpus   = 2
                memory = '16.GB'
                time   = '168.h'
                maxForks = 20 // limit number of ALIGN jobs 
            }
            withName: QUALIMAP{
                cpus   = 1
                memory = '16.GB'
                time   = '168.h'
            }
            withName: INDEX_BAMS{
                cpus = 10
                memory = '100.GB'
                time = '168.h'
            }
            withName: 'CALC_COVERAGE|CALC_LR|TRAIN_HMM|RUN_HMM' {
                container = "${projectDir}/containers/ngsparalog_sandbox"
                beforeScript = 'module load singularity-ce/singularity-ce.4.1.4; export SINGULARITY_TMPDIR=/scratch/miclark/singularity_tmp; mkdir -p $SINGULARITY_TMPDIR'
            }             
            withName: SPLIT_GENOME {
                beforeScript = 'source /software/utils/miniconda3/3.13/etc/profile.d/conda.sh'
            }
            withName: CALC_LR{
                cpus = 1
                memory = '50.GB'
                time = '168.h'
            }
            withName: TRAIN_HMM{
                cpus = 1
                memory = '200.GB'
                time = '168.h'
            }
            withName: RUN_HMM{
                cpus = 1
                memory = '100.GB'
                time = '168.h'
            }
            withName: DEPTH_HIST {
                cpus = 1
                memory = '200.GB'
                time = '168.h'
            }
            withName: PRUNE_LD_GRAPH {
                cpus = 8
                memory = '500.GB'
                time = '168.h'
            }

        }
    }
}


// Output settings
outputDir = params.outdir
workflow.output.mode = 'copy'
