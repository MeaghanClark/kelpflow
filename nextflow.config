// Define work directory
workDir='/scratch/miclark/kelpflow_temp'

// Default parameters
params {
    input_dir  = null
    outdir = 'results'
    reference_genome = '/home/miclark/MpyrAdapt/data/reference/Mpyr-NLJ1B.v3.hap1.softmasked.fasta'
    raw_report_name = 'raw_reads_qc'
    trimmed_report_name = 'trimmed_reads_qc'
    qualimap_report_name = 'filtered_bams_qc'
}

// Base resource settings
process {
    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : (task.attempt <= 2 ? 'retry' : 'finish') }
    maxRetries    = 2}

profiles {

    // Run everything on the machine executing `nextflow run`
    standard {
        process.executor = 'local'

        docker.enabled       = true
        singularity.enabled  = false

        // Cap total resources Nextflow is allowed to use on this machine
        executor {
            cpus   = 8
            memory = '32.GB'
        }
    }

    // Slurm settings
    slurm {
        process.executor = 'slurm'
        process.queue    = 'general'   // your partition/queue name

        singularity.enabled = false     // disabled for now
        docker.enabled      = false
        conda.enabled       = true

        executor {
            queueSize = 24
            submitRateLimit = '10/1min'   // throttle how fast Nextflow submits jobs
            exitReadTimeout = '1000 sec'
        }

        // use withLabel or withName to specify module-specific resource usage
        process {
            // cluster options for UCSC elkhorn
            clusterOptions = '--partition=lab-mpinsky --qos=pi-mpinsky --account=pi-mpinsky'

            withLabel: process_low {
                cpus   = 1
                memory = '4.GB'
                time   = '24.h'
            }
            withLabel: process_medium {
                cpus   = 4
                memory = '64.GB'
                time   = '72.h'
            }
            withLabel: process_high {
                cpus   = 16
                memory = '200.GB'
                time   = '168.h'
            }
            withName: ALIGN{
                cpus   = 2
                memory = '8.GB'
                time   = '168.h'
                maxForks = 20 // limit number of ALIGN jobs 
            }
            withName: QUALIMAP{
                cpus   = 1
                memory = '16.GB'
                time   = '168.h'
            }

        }
    }
}


// Output settings
outputDir = params.outdir
workflow.output.mode = 'copy'
