process ALIGN {
    tag "$meta.id"
    label 'process_high'

    module 'bwa-mem2/2.2.1:samtools/1.21:miniconda3'
    conda 'bioconda::bamutil'

    input:
    tuple val(meta), path(forward), path(reverse), path(merged), val(ref_meta), path(ref_genome), path(index_files)
    
    output:
    tuple val(meta), path("*minfilt.bam"), path("*minfilt.bam.bai"), emit: bam_minfilt
    tuple val(meta), path("*rmdup.bam"), path("*rmdup.bam.bai"), emit: bam_filt

    script:
    // Define data string used for read group information
        // eventually may want to make this a parameter or configurable option
    def datastring = ''
    if (meta.id.contains('MOL')) {
        datastring = 'Whole genome sequence from Macrocystis pyrifera from Molano et al., PRJNA661280'
    } else if (meta.id.contains('ALB')) {
        datastring = 'Whole genome sequence from Macrocystis pyrifera generated by Alberto lab 2025'
    } else if (meta.id.contains('GON')) {
        datastring = 'Whole genome sequence from Macrocystis pyrifera from Gonzalez et al., PRJNA938791'
    }

    """
    set -e
    set -o pipefail

    # Read-group detection
    prevrg='N'
    readgroup=''
    nmatch=0
    lstart=-3

    tmpfile=\$(mktemp)
    set +o pipefail
    zcat ${forward} | head -n 4000 > "\$tmpfile"
    set -o pipefail

    while [ \$nmatch -lt 10 ]
    do
        lstart=\$((lstart + 4))
        lend=\$((lstart + 1))
        readheader=\$(sed -n "\${lstart}p;\${lend}q" "\$tmpfile" | sed 's/ [[:digit:]]//')
        readinfo=(\$(echo "\$readheader" | perl -e 'chomp(\$read = <>); @arr = split(/:/,\$read); print "@arr[2,3,\$#arr]";'))
        barcode=\$(sed 's/+/-/' <<< "\${readinfo[2]}")

        readgroup="@RG\\tID:\${readinfo[0]}.\${readinfo[1]}\\tBC:\${barcode}\\tDS:${datastring}\\tLB:${meta.id}\\tPL:ILLUMINA\\tPU:\${readinfo[0]}.\${readinfo[1]}.\${barcode}\\tSM:${meta.id}"

        # if [ "\$readgroup" = "\$prevrg" ] && ! [[ "\$barcode" =~ 'N' ]]; then ((nmatch++)); fi
        if [ "\$readgroup" = "\$prevrg" ] && ! [[ "\$barcode" =~ 'N' ]]; then
            nmatch=\$((nmatch + 1))
        fi
        prevrg="\$readgroup"
    done

    rm "\$tmpfile"

    # Alignment 

    bwa-mem2 mem -t ${task.cpus} -R "\$readgroup" ${ref_genome} ${forward} ${reverse} | samtools view -@ ${task.cpus} -b > ${meta.id}.aln-pe.bam
    bwa-mem2 mem -t ${task.cpus} -R "\$readgroup" ${ref_genome} ${merged} | samtools view -@ ${task.cpus} -b > ${meta.id}.aln-se.bam

    # Alignment processing

    # clip overlap from paired reads
    samtools sort -@ ${task.cpus} ${meta.id}.aln-pe.bam \\
        | bam clipOverlap --in -.bam --out ${meta.id}.aln-pe.clipped.bam --unmapped --stats

    # make minimally filtered bam file for ngsParalog 

    # PE: remove unmapped reads and duplicates
    samtools view -F 0x4 -b ${meta.id}.aln-pe.clipped.bam \\
        | samtools sort -n -@ ${task.cpus} \\
        | samtools fixmate -m - - \\
        | samtools sort -@ ${task.cpus} \\
        | samtools markdup -r - ${meta.id}.minfilt-pe.bam
    
    # SE: remove unmapped reads
    samtools view -F 0x4 -b ${meta.id}.aln-se.bam \\
        | samtools sort -@ ${task.cpus} -o ${meta.id}.minfilt-se.bam

    # Merge PE and SE for ngsParalog
    samtools merge -f -@ ${task.cpus} \\
        ${meta.id}.minfilt.bam \\
        ${meta.id}.minfilt-pe.bam \\
        ${meta.id}.minfilt-se.bam
    samtools index ${meta.id}.minfilt.bam

    # continue with bam filtering for angsd genotype likelihoods 

    # PE: sort by name, fixmate, filter proper pairs, position sort
    samtools sort -n -@ ${task.cpus} ${meta.id}.aln-pe.clipped.bam \\
        | samtools fixmate -m - - \\
        | samtools view -f 0x2 -b \\
        | samtools sort -@ ${task.cpus} \\
        > ${meta.id}.fixmate-pe.bam

    # SE: filter unmapped 
    samtools view -F 0x4 -b ${meta.id}.aln-se.bam \\
        | samtools sort -@ ${task.cpus} -o ${meta.id}.filt-se.bam

    # merge paired and single end bam files and markdups
    samtools merge -f -@ ${task.cpus} - \\
        ${meta.id}.fixmate-pe.bam \\
        ${meta.id}.filt-se.bam \\
        | samtools sort -@ ${task.cpus} \\
        | samtools markdup -r -@ ${task.cpus} - ${meta.id}.rmdup.bam

    samtools index ${meta.id}.rmdup.bam

    # clean up intermediate files
    rm ${meta.id}.aln-pe.bam ${meta.id}.aln-se.bam ${meta.id}.aln-pe.clipped.bam ${meta.id}.minfilt-pe.bam ${meta.id}.minfilt-se.bam ${meta.id}.fixmate-pe.bam ${meta.id}.filt-se.bam
    """
}