# ngsparalog.def
Bootstrap: docker
From: continuumio/miniconda3:latest

%post
    apt-get update && apt-get install -y \
        build-essential \
        git \
        gcc \
        g++

    # Build ngsParalog
    cd /opt
    git clone https://github.com/tplinderoth/ngsParalog
    cd ngsParalog
    make

    # Install samtools into the base environment
    conda install -y -c bioconda -c conda-forge samtools=1.21

    # Build the dupHMM conda environment for the R-based HMM steps
    conda config --set channel_priority strict
    conda create -n dupHMM -y -c conda-forge \
        r-base r-truncnorm r-docopt r-expm r-codetools

    conda run -n dupHMM Rscript -e "install.packages('docopt', repos='https://cloud.r-project.org')"

    conda clean -a -y

%environment
    export PATH=/opt/ngsParalog:$PATH
    export PATH=/opt/conda/envs/dupHMM/bin:$PATH

%labels
    Author your_name
    Version v1.0
    Source https://github.com/tplinderoth/ngsParalog